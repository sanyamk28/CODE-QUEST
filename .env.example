# PlacementForge Environment Variables Example

# System Environment
ENV_MODE=development # development | production
SECRET_KEY=supersecretjwtkeyplacementforgechangeinproduction
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Primary Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=placementforge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Secondary Database / Cache (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Code Execution Sandbox
SANDBOX_SECRET_TOKEN=sandboxsecrettokenchangeinprod
SANDBOX_HOST=sandbox-executor
SANDBOX_PORT=8080

# AI/LLM Integration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Firebase Cloud Messaging
FCM_SERVER_KEY=YOUR_FCM_SERVER_KEY

# Admin Dashboard Defaults
ADMIN_DEFAULT_EMAIL=admin@placementforge.com
ADMIN_DEFAULT_PASSWORD=adminsecurepass123
